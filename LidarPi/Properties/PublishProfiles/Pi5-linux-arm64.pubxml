<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile for the Raspberry Pi 5 (64-bit Raspberry Pi OS).
  Visual Studio: right-click LidarPi -> Publish -> Pi5-linux-arm64 -> Publish.
  Command line:  dotnet publish LidarPi -p:PublishProfile=Pi5-linux-arm64
  Output:        LidarPi\bin\publish\linux-arm64\   (copy this whole folder to the Pi)
  Self-contained = the .NET runtime is included, so nothing has to be installed on the Pi.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishUrl>bin\publish\linux-arm64\</PublishUrl>
    <PublishDir>bin\publish\linux-arm64\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- Keep the portable .pdb next to the binary for remote debugging with vsdbg. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
