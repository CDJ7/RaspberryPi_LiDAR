{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "LidarPi.Api.BasicAuthHandler": "Warning"
    }
  },
  "AllowedHosts": "*",

  "LidarAgv": {
    "ListenAddress": "0.0.0.0",
    "HttpPort": 5000,
    "ConfigPath": "",

    "Lidar": {
      "Port": "/dev/rplidar",
      "Baud": 115200,
      "Clockwise": true,
      "MinRangeM": 0.15,
      "MaxRangeM": 8.0,
      "MinQuality": 5,
      "ReconnectSeconds": 2.0,
      "MaxBacklogBytes": 3000
    },

    "Safety": {
      "StaleTimeoutSeconds": 0.6,
      "MinValidPoints": 20,
      "LoopPeriodMs": 10,
      "EStopTripSamples": 2,
      "EStopReleaseStableMs": 50,
      "RequireResetAtStartup": true,
      "LedTestMaxSeconds": 300,
      "FlashHalfPeriodMs": 250
    },

    "Gpio": {
      "Chip": "auto",
      "GreenLedPin": 5,
      "YellowLedPin": 6,
      "RedLedPin": 13,
      "EStopPin": 26,
      "MotionEnablePin": 21
    },

    "Lcd": {
      "I2cBus": 1,
      "UpdatePeriodMs": 200,
      "RetrySeconds": 5.0
    },

    "Simulation": {
      "RateHz": 7.0,
      "Beams": 360
    }
  }
}
