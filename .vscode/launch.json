{
  // VS Code run/debug configurations (needs the "C#" / "C# Dev Kit" extension).
  // Pick "Simulator + GUI" in the Run and Debug view and press F5 to start both programs.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LidarPi (simulate)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build LidarAgv",
      "program": "${workspaceFolder}/LidarPi/bin/Debug/net8.0/LidarPi.dll",
      "args": ["--simulate"],
      "cwd": "${workspaceFolder}/LidarPi/bin/Debug/net8.0",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "LidarPi (check, simulated)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build LidarAgv",
      "program": "${workspaceFolder}/LidarPi/bin/Debug/net8.0/LidarPi.dll",
      "args": ["--check", "--simulate", "--scans", "10"],
      "cwd": "${workspaceFolder}/LidarPi/bin/Debug/net8.0",
      "console": "integratedTerminal"
    },
    {
      "name": "LidarPC (GUI)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/LidarPC/bin/Debug/net8.0-windows/LidarPC.dll",
      "cwd": "${workspaceFolder}/LidarPC",
      "console": "internalConsole"
    },
    {
      // Debug the program RUNNING ON THE PI over ssh (README "Remote debugging").
      // Needs: ssh-copy-id done, vsdbg installed on the Pi in ~/vsdbg, and the program deployed
      // from THIS laptop with ./deploy.sh (so the .pdb matches these sources). Pick "LidarPi" in the list.
      "name": "Attach to LidarPi on the Pi (ssh)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "ssh",
        "pipeArgs": ["-T", "cdj5x@192.168.1.100"],
        "debuggerPath": "~/vsdbg/vsdbg"
      },
      // The publish build is Release (optimised): some locals show as "optimized away"; breakpoints work.
      "justMyCode": false,
      "requireExactSource": false
    }
  ],
  "compounds": [
    {
      // Builds once (via the LidarPi config's preLaunchTask), then starts the simulator and the GUI.
      "name": "Simulator + GUI",
      "configurations": ["LidarPi (simulate)", "LidarPC (GUI)"],
      "stopAll": true
    }
  ]
}
